{
  "version": 2,
  "name": "nexkirana-accounting-api",
  "builds": [
    {
      "src": "./index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ],
  "env": {
    "MONGODB_URI": "@mongodb_uri",
    "JWT_SECRET": "@jwt_secret",
    "JWT_EXPIRES_IN": "8h",
    "NODE_ENV": "production",
    "COMPANY_NAME": "NexKirana",
    "SESSION_TIMEOUT": "480"
  }
}